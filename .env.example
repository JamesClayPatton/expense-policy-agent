# Copy to .env and fill in. Never commit .env.

# --- Postgres with pgvector ---
# Supabase: Connect -> Session pooler. Local Docker: see README.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:5432/postgres

# Only needed if you use the Supabase client or Data API (the agent does not).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-key

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models. Pin exact versions so before/after runs are comparable.
AGENT_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith ---
# The key must be able to read prompts, not only write traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=expense-policy-agent

# Prompts live in LangSmith. Each value is the prompt name, a colon, and the
# commit hash. Dropping the hash pulls the latest commit instead of the pinned one.
AGENT_PROMPT=expense-agent-system:3837744f
JUDGE_PROMPT=expense-judge:614b1703
